# Browser development can use an empty value when the Express server is serving the app.
# Android APK builds should set this to the public HTTPS URL of the Gridscape API server.
VITE_API_BASE_URL=https://your-gridscape-api.example.com

# Server-side only. Never expose this in VITE_* variables or commit the real value.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional: comma-separated origins allowed to call the API.
# Example: https://your-gridscape-web.example.com,https://localhost,http://localhost
CORS_ORIGINS=*
